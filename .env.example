# =====================================================
# Plantilla de variables de entorno
# Copia este archivo a .env y reemplaza los valores de relleno.
#   cp .env.example .env
# El archivo .env está en .gitignore: nunca lo subas al repositorio.
# Docker Compose lee .env automáticamente.
# =====================================================

# -----------------------------------------------------
# Base de datos (PostgreSQL) — usadas por docker-compose.yml
# -----------------------------------------------------
DB_USER=drogueria_user
DB_PASSWORD=cambia_esta_password

# -----------------------------------------------------
# Seguridad
# -----------------------------------------------------
# Clave para firmar los JWT: mínimo 32 caracteres. Genera una con:
#   openssl rand -base64 48
APP_JWT_SECRET=una_clave_secreta_de_al_menos_32_caracteres

# -----------------------------------------------------
# Stripe — pasarela de pago (modo test)
# https://dashboard.stripe.com/test/apikeys
# -----------------------------------------------------
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY
STRIPE_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PUBLIC_KEY

# -----------------------------------------------------
# Correo (SMTP)
# Cualquier proveedor SMTP sirve (Resend, Brevo, AWS SES, Gmail...).
# MAIL_FROM debe ser una dirección o dominio verificado en el proveedor.
# Para probar localmente sin proveedor real usa docker-compose.demo.yml (Mailpit).
# -----------------------------------------------------
MAIL_HOST=smtp.tu-proveedor.com
MAIL_PORT=587
MAIL_USERNAME=usuario_smtp
MAIL_PASSWORD=password_smtp
MAIL_FROM=no-reply@tu-dominio.com

# -----------------------------------------------------
# Aplicación
# -----------------------------------------------------
# URL del frontend (se usa en los enlaces de los correos y en CORS)
FRONTEND_URL=http://localhost:5173

# Swagger UI público (true/false). Por defecto false: solo lo ve un ADMIN autenticado.
# Ponlo en true únicamente en demos.
APP_DOCS_PUBLIC=false

# -----------------------------------------------------
# Solo desarrollo local con el perfil "dev" (mvn spring-boot:run)
# -----------------------------------------------------
DEV_DB_PASSWORD=tu_password_postgres_local
