# =====================================================
# Plantilla de variables de entorno
# Copia este archivo a .env y completa los valores reales
# El archivo .env está en .gitignore y no se sube al repo
# =====================================================

# Stripe — Pasarela de Pago
# Obtén tus claves en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_REPLACE_WITH_YOUR_SECRET_KEY
STRIPE_PUBLIC_KEY=pk_test_REPLACE_WITH_YOUR_PUBLIC_KEY

# Email — AWS SES SMTP (prod). Credenciales SMTP generadas en SES (NO el IAM Role ni access keys).
# MAIL_FROM debe ser una identidad (correo/dominio) verificada en SES.
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=SES_SMTP_USERNAME
MAIL_PASSWORD=SES_SMTP_PASSWORD
MAIL_FROM=no-reply@tu-dominio-verificado.com

# JWT
APP_JWT_SECRET=una_clave_secreta_de_al_menos_32_caracteres
