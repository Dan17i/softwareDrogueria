# Copiar como .env en el servidor EC2 y completar los valores

# Base de datos (PostgreSQL local en Docker)
DB_USER=drogueria_user
DB_PASSWORD=cambia_esto

# JWT — genera con: openssl rand -hex 32
APP_JWT_SECRET=cambia_esto

# Email (opcional — dejar vacío desactiva el envío)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@bellavista.com

# URL del frontend
FRONTEND_URL=https://drogueria-bellavista.netlify.app
